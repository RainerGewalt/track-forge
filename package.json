{
  "name": "track-forge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "piece:create": "node scripts/create-piece.mjs",
    "pieces:validate": "node scripts/validate-pieces.mjs",
    "samples:seed": "node scripts/samples/seed-vcsl.mjs",
    "samples:discover": "node scripts/samples/discover.mjs",
    "samples:download": "node scripts/samples/download.mjs",
    "samples:inspect": "node scripts/samples/inspect-audio.mjs",
    "samples:curate": "node scripts/samples/curate.mjs",
    "samples:build": "node scripts/samples/build-library.mjs",
    "samples:audit": "node scripts/samples/audit.mjs",
    "player:certificate": "bash scripts/generate-player-certificate.sh",
    "player:start": "bash scripts/player-stack.sh start",
    "player:stop": "docker compose down",
    "test": "node --test tests/*.test.mjs",
    "timeline:previews": "node --experimental-loader ./scripts/timeline/stub-loader.mjs scripts/timeline/generate.mjs",
    "images:manifest": "node scripts/images/manifest.mjs",
    "first-use": "bash scripts/first-use.sh"
  },
  "dependencies": {
    "@strudel/repl": "1.3.0"
  },
  "devDependencies": {
    "vite": "6.4.3"
  },
  "description": "A track studio for Strudel: turn live-coding patterns into complete tracks with visual arrangement lanes and a phone-friendly LAN player.",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RainerGewalt/track-forge.git"
  },
  "bugs": {
    "url": "https://github.com/RainerGewalt/track-forge/issues"
  },
  "homepage": "https://rainergewalt.github.io/track-forge/",
  "engines": {
    "node": ">=20"
  }
}
