// EXAMPLE TRACK — Skin family solo: open call, muted answer.
setcpm(100 / 4)

const open = note("e2").s("triangle").struct("<[t ~ ~ ~] [~ ~ t ~]>")
  .penv(9).pdecay(.1)
  .decay(.4).sustain(0)
  .lpf(900).orbit(11)

const muted = note("b3").s("triangle").struct("<~ [~ t ~ t]>")
  .penv(10).pdecay(.02)
  .decay(.08).sustain(0)
  .hpf(300).late(.006).orbit(11)

stack(open.velocity(perlin.range(.7, 1)).gain(.4), muted.gain(.18))
