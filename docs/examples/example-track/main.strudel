// EXAMPLE TRACK — a minimal six-family arrangement.
// One cycle is one 4/4 bar at 100 BPM. The 50-bar form lasts exactly 2:00.
// E Aeolian. Synth-only, so it plays without the sample library; swap the
// builders for `s("bot_…")` banks once you have run the samples pipeline.
// States: floor -> motion -> voice -> residue.

setcpm(100 / 4)

// One motif, one family per orbit — see agents/composition-rules.md.
const MOTIF = "<e4 g4 ~ f#4 e4 ~ d4 [e4 g4]>"

// PULSE — orbit 10: a soft kick that carries the time axis.
const kick = (hits) =>
  note("e1").s("sine").struct(hits)
    .penv(18).pdecay(.06)
    .decay(.28).sustain(0)
    .shape(.2).orbit(10)

// SKIN — orbit 11: one synthetic hand-drum family, open and muted.
const drumOpen = (hits) =>
  note("e2").s("triangle").struct(hits)
    .penv(9).pdecay(.1)
    .decay(.4).sustain(0)
    .lpf(900).orbit(11)

const drumMuted = (hits) =>
  note("b3").s("triangle").struct(hits)
    .penv(10).pdecay(.02)
    .decay(.08).sustain(0)
    .hpf(300).orbit(11)
    .late(.006)

// SEED — orbit 12: one filtered noise tick.
const tick = (hits) =>
  s("white").struct(hits)
    .decay(.03).sustain(0)
    .hpf(4500).lpf(9000).orbit(12)

// TREMOR — orbit 13: a low detuned saw that thickens into a wall.
const wall = (hits) =>
  note("e3").s("sawtooth").struct(hits)
    .superimpose(p => p.add(note(.1)))
    .decay(.12).sustain(.2)
    .hpf(120).lpf(1600).shape(.25)
    .room(.25).roomsize(2).orbit(13)

// MEMORY — orbit 14: the single melodic voice.
const memoryVoice = (melody) =>
  note(melody).s("triangle")
    .attack(.05).decay(.3).sustain(.4).release(.8)
    .lpf(2400)
    .room(.35).roomsize(3).orbit(14)

// GROUND — orbit 15: one drone plus controlled air.
const drone = note("[e1,e2]").slow(2).s("sawtooth")
  .attack(2).release(3).sustain(.8)
  .lpf(170).gain(.22).orbit(15)

const air = s("brown").struct("t").slow(4)
  .attack(2).release(3).sustain(.5)
  .hpf(100).lpf(600).gain(.05).orbit(15)

// Layers — 50 bars: 10 / 10 / 15 / 15.
const pulseLayer = arrange(
  [10, kick("t ~ t ~").gain(.5)],
  [10, kick("t*4").gain(.65)],
  [15, kick("t*4").gain(.7)],
  [15, kick("<t ~ t ~>").gain("<.5 .35 .2 .1>/4")],
)

const skinLayer = arrange(
  [10, drumOpen("<[t ~ ~ ~] ~>").gain(.3)],
  [10, stack(drumOpen("<[t ~ ~ ~] [~ ~ t ~]>").gain(.35), drumMuted("<~ [~ t ~ ~]>").gain(.15))],
  [15, stack(drumOpen("<[t ~ ~ ~] [~ ~ t ~]>").velocity(perlin.range(.7, 1)).gain(.4),
             drumMuted("<~ [~ t ~ t]>").gain(.18))],
  [15, drumOpen("<[t ~ ~ ~] ~>").room(.5).gain("<.3 .2 .1 .05>/4")],
)

const seedLayer = arrange(
  [10, silence],
  [10, tick("t*8").degradeBy(.6).gain(.08)],
  [15, tick("t*16").degradeBy(.4).velocity("<[.9 .5 .6 .8]!4>").gain(.11)],
  [15, tick("t*8").degradeBy(.8).gain(.05)],
)

const tremorLayer = arrange(
  [10, wall("t*4").lpf(900).gain(.12)],
  [10, wall("t*8").gain(.16)],
  [15, wall("t*8").lpf(2000).velocity("<[.9 .5 .6 .8]!4>").gain(.2)],
  [15, wall("t*4").lpf(700).gain(.1)],
)

const memoryLayer = arrange(
  [10, memoryVoice("<e4 ~ ~ ~ ~ ~ ~ ~>").gain(.15)],
  [10, memoryVoice(MOTIF).degradeBy(.5).gain(.2)],
  [15, memoryVoice(MOTIF).gain(.28)],
  [15, memoryVoice("<e4 ~ g4 ~ ~ ~ e4 ~>").degradeBy(.3).gain("<.2 .14 .08 .04>/4")],
)

const groundLayer = arrange(
  [20, stack(drone.lpf(140), air)],
  [15, stack(drone, air)],
  [15, stack(drone.gain("<.2 .14 .08 .04>/4"), air.gain(.03))],
)

stack(pulseLayer, skinLayer, seedLayer, tremorLayer, memoryLayer, groundLayer)
