# Required before the Studio can permanently overwrite Strudel source files.
# Use a long, private value and enter the same value in the confirmation dialog.
SOURCE_EDITOR_TOKEN=replace-with-a-long-random-token

# Match the host user so atomically replaced files keep editable ownership.
SOURCE_UID=1000
SOURCE_GID=1000

# Host ports of the LAN player (defaults: 80 and 443). Set them when another
# program already uses 80 or 443, or for rootless Docker, which cannot bind
# ports below 1024. Devices then open https://<lan-ip>:8443/.
# PLAYER_HTTP_PORT=8080
# PLAYER_HTTPS_PORT=8443

# Publish the player on one address only (default: all addresses).
# PLAYER_BIND_ADDRESS=192.168.1.20
